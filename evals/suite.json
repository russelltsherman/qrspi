          "type": "programmatic",
          "check": "all_tasks_have_required_fields('worktree.md')",
          "weight": 1.5
        },
        {
          "type": "programmatic",
          "check": "session_boundaries_have_reasons('worktree.md')",
          "weight": 1.0
        },
        {
          "type": "programmatic",
          "check": "sessions_have_load_manifests('worktree.md')",
          "weight": 1.5
        },
        {
          "type": "llm_judge",
          "criteria": "Session load manifests reference specific sections of artifacts, not entire documents — no session loads everything",
          "weight": 2.0
        },
        {
          "type": "llm_judge",
          "criteria": "Tasks within a slice are sequential; tasks across independent slices are correctly identified as parallelizable",
          "weight": 1.5
        }
      ],
      "tags": ["worktree", "happy-path", "sessions"],
      "difficulty": "medium",
      "split": "train"
    },
    {
      "id": "case_011",
      "name": "implement_scope_enforcement",
      "phase": "implement",
      "prompt": "Implement the tasks assigned to this session. Do not touch code outside your scope.",
      "context": {
        "files": [
          "fixtures/worktree_session1.md",
