        {
          "type": "programmatic",
          "check": "impl_log_has_required_fields('impl-log.md')",
          "weight": 1.5
        },
        {
          "type": "script",
          "check": "scripts/check_scope.py --log impl-log.md --allowed fixtures/worktree_session1.md",
          "weight": 2.5
        },
        {
          "type": "llm_judge",
          "criteria": "Agent only modified files listed in the session task list — no opportunistic refactoring of unrelated code",
          "weight": 3.0
        }
      ],
      "tags": ["implement", "happy-path", "scope"],
      "difficulty": "medium",
      "split": "train"
    },
